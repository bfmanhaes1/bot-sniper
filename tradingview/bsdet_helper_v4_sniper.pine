// =====================================================================
//  BSDET HELPER v4 — Bot SNIPER (camada de CONFIRMAcAO consolidada)
// =====================================================================
//  POR QUE ESTE HELPER MUDOU
//  -------------------------
//  O Pine (linguagem do TradingView) so consegue ler o VALOR (numero) de
//  um plot de outro indicador, NUNCA a COR dele. O "TSTS BS Detector"
//  pinta os plots com 6 cores por uma logica interna FECHADA (nao e um
//  simples "subindo/descendo"). Por isso a versao antiga, que tentava
//  adivinhar a cor pelo valor, nao batia com o original.
//
//  SOLUCAO (por APROXIMACAO): este helper agora CALCULA a cor por conta
//  propria, a partir do PRECO, usando as mesmas contas do indicador
//  ABERTO "Trend Meter (by Lij_MC)" — que muda de cor lateralmente igual
//  aos plots do BS Detector. Para cada componente (Histograma, Plot1,
//  Plot2, Plot3) voce ESCOLHE qual conta usar e vai calibrando ate o
//  PAINEL deste helper ficar igual ao BS Detector no grafico.
//
//  IMPORTANTE: e uma APROXIMACAO. Nao sabemos as regras exatas do BS
//  Detector, entao voce ajusta o menu de cada componente (e o "inverter")
//  ate as cores baterem. Depois disso o alerta ja manda tudo certo.
//
//  COMO USAR (resumo — guia completo no .md que acompanha):
//   1) Adicione o "TSTS BS Detector" no grafico (para comparar as cores).
//   2) Adicione ESTE indicador (BSDET HELPER v4) no MESMO grafico.
//   3) Em cada componente, escolha no menu qual conta do Trend Meter usar
//      e marque "inverter" se a cor sair trocada. Compare o PAINEL (canto
//      superior direito) com as cores do BS Detector ate baterem.
//   4) Crie 1 alerta: condicao = "BSDET v4: estado (JSON)",
//      "Once Per Bar Close", webhook para:
//         https://web-production-77454.up.railway.app/bsdet/estado/<MOEDA>/<TF>
//      (ex.: .../bsdet/estado/BTC/5m). A mensagem ja sai pronta.
// =====================================================================

//@version=5
indicator("BSDET HELPER v4 — SNIPER", overlay=false)

// =====================================================================
//  CONTAS DO TREND METER (by Lij_MC) — todas devolvem VERDE(true)/VERMELHO(false)
// =====================================================================
// 1) Fast MACD 8/21/5  -> histograma do MACD rapido > 0
fastMacdLine = ta.ema(close, 8) - ta.ema(close, 21)
fastSignal   = ta.ema(fastMacdLine, 5)
fastHist     = fastMacdLine - fastSignal
tmFastMacd   = fastHist > 0

// 2) MACD 12/26/9  -> histograma do MACD classico > 0
macdLine   = ta.ema(close, 12) - ta.ema(close, 26)
macdSignal = ta.ema(macdLine, 9)
macdHist   = macdLine - macdSignal
tmMacd     = macdHist > 0

// 3) RSI 13 > 50
tmRsi13 = ta.rsi(close, 13) > 50

// 4) RSI 5 > 50
tmRsi5 = ta.rsi(close, 5) > 50

// 5) Mom/Dad Cross (Top Dog Trading)
tdMom  = ta.ema(close, 5) - ta.ema(close, 20)
tdDad  = ta.ema(tdMom, 30)
tmMomDad = tdMom > tdDad

// 6) RSI Signal Line Cross (RSI 13 x linreg 21)
r13   = ta.rsi(close, 13)
r13lr = ta.linreg(r13, 21, 0)
tmRsiSig = r13 > r13lr

// 7) MA Cross (EMA 5 x EMA 11)
tmMaCross = ta.ema(close, 5) > ta.ema(close, 11)

// 8) Trend Candles (Heikin-Ashi: vela de alta = verde)
haClose = (open + high + low + close) / 4
var float haOpen = na
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
tmTrendCandles = haClose >= haOpen

// =====================================================================
//  FONTES OPCIONAIS (fallback) — so use se preferir ler um plot direto
// =====================================================================
srcHist = input.source(close, "Fonte Histograma (opcional/fallback)", group="Fontes opcionais")
srcP1   = input.source(close, "Fonte Plot 1 (opcional/fallback)",    group="Fontes opcionais")
srcP2   = input.source(close, "Fonte Plot 2 (opcional/fallback)",    group="Fontes opcionais")
srcP3   = input.source(close, "Fonte Plot 3 (opcional/fallback)",    group="Fontes opcionais")
limiar  = input.float(0.0, "Limiar da fonte (Positivo/Negativo)",     group="Fontes opcionais")

// =====================================================================
//  MENU: qual conta cada componente usa
// =====================================================================
modoHist = input.string("Fonte: Positivo", "Histograma: qual conta", 
  options=["Fonte: Positivo", "Fonte: Negativo", "Fonte: Subindo", "Fonte: Descendo", "Fast MACD 8/21/5", "MACD 12/26/9", "RSI 13 > 50", "RSI 5 > 50", "Mom/Dad Cross", "RSI Signal Cross 13/21", "MA Cross 5/11", "Trend Candles"], 
  group="Regra de cor por componente")
invHist  = input.bool(false, "Histograma: inverter cor", group="Regra de cor por componente")

modoP1   = input.string("Fonte: Positivo", "Plot 1: qual conta", 
  options=["Fonte: Positivo", "Fonte: Negativo", "Fonte: Subindo", "Fonte: Descendo", "Fast MACD 8/21/5", "MACD 12/26/9", "RSI 13 > 50", "RSI 5 > 50", "Mom/Dad Cross", "RSI Signal Cross 13/21", "MA Cross 5/11", "Trend Candles"], 
  group="Regra de cor por componente")
invP1    = input.bool(false, "Plot 1: inverter cor", group="Regra de cor por componente")

modoP2   = input.string("Fonte: Positivo", "Plot 2: qual conta", 
  options=["Fonte: Positivo", "Fonte: Negativo", "Fonte: Subindo", "Fonte: Descendo", "Fast MACD 8/21/5", "MACD 12/26/9", "RSI 13 > 50", "RSI 5 > 50", "Mom/Dad Cross", "RSI Signal Cross 13/21", "MA Cross 5/11", "Trend Candles"], 
  group="Regra de cor por componente")
invP2    = input.bool(false, "Plot 2: inverter cor", group="Regra de cor por componente")

modoP3   = input.string("Fonte: Positivo", "Plot 3: qual conta", 
  options=["Fonte: Positivo", "Fonte: Negativo", "Fonte: Subindo", "Fonte: Descendo", "Fast MACD 8/21/5", "MACD 12/26/9", "RSI 13 > 50", "RSI 5 > 50", "Mom/Dad Cross", "RSI Signal Cross 13/21", "MA Cross 5/11", "Trend Candles"], 
  group="Regra de cor por componente")
invP3    = input.bool(false, "Plot 3: inverter cor", group="Regra de cor por componente")

// =====================================================================
//  Seletor: transforma a escolha do menu em VERDE(true)/VERMELHO(false)
// =====================================================================
escolher(_modo, _src, _inv) =>
    _verde = switch _modo
        "Fast MACD 8/21/5"        => tmFastMacd
        "MACD 12/26/9"            => tmMacd
        "RSI 13 > 50"             => tmRsi13
        "RSI 5 > 50"              => tmRsi5
        "Mom/Dad Cross"           => tmMomDad
        "RSI Signal Cross 13/21"  => tmRsiSig
        "MA Cross 5/11"           => tmMaCross
        "Trend Candles"           => tmTrendCandles
        "Fonte: Positivo"         => _src >= limiar
        "Fonte: Negativo"         => _src <  limiar
        "Fonte: Subindo"          => _src > _src[1]
        "Fonte: Descendo"         => _src < _src[1]
        => _src >= limiar
    _final = _inv ? not _verde : _verde
    _final ? "green" : "red"

cHist = escolher(modoHist, srcHist, invHist)
cP1   = escolher(modoP1,   srcP1,   invP1)
cP2   = escolher(modoP2,   srcP2,   invP2)
cP3   = escolher(modoP3,   srcP3,   invP3)

// =====================================================================
//  Mensagem JSON consolidada (uma por fechamento de vela)
// =====================================================================
msg = '{"timeframe":"' + timeframe.period + '","hist":"' + cHist +
      '","p1":"' + cP1 + '","p2":"' + cP2 + '","p3":"' + cP3 + '"}'
alert(msg, alert.freq_once_per_bar_close)

// =====================================================================
//  Painel visual (para comparar com o BS Detector no grafico)
// =====================================================================
corCel(_c) => _c == "green" ? color.new(color.green, 0) : color.new(color.red, 0)
var table painel = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(painel, 0, 0, "Histograma", text_color=color.white)
    table.cell(painel, 1, 0, cHist, bgcolor=corCel(cHist), text_color=color.white)
    table.cell(painel, 0, 1, "Plot 1", text_color=color.white)
    table.cell(painel, 1, 1, cP1, bgcolor=corCel(cP1), text_color=color.white)
    table.cell(painel, 0, 2, "Plot 2", text_color=color.white)
    table.cell(painel, 1, 2, cP2, bgcolor=corCel(cP2), text_color=color.white)
    table.cell(painel, 0, 3, "Plot 3", text_color=color.white)
    table.cell(painel, 1, 3, cP3, bgcolor=corCel(cP3), text_color=color.white)
    table.cell(painel, 0, 4, "TF", text_color=color.white)
    table.cell(painel, 1, 4, timeframe.period, text_color=color.white)
